<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.saas-infrastructure.notavia</groupId>
  <artifactId>notavia</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>
  <name>Notavia Java SDK</name>
  <description>Official Java SDK for Notavia — send transactional notifications and manage templates.</description>
  <url>https://docs.notavia.saas-infrastructure.com</url>

  <licenses>
    <license>
      <name>MIT</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <!-- Maven Central requires a developer entry. It does not require a natural person, and this
       one is deliberately the operating company rather than an individual. -->
  <developers>
    <developer>
      <name>Tessora LLC</name>
      <organization>Tessora LLC</organization>
      <organizationUrl>https://saas-infrastructure.com</organizationUrl>
      <email>hello@saas-infrastructure.com</email>
    </developer>
  </developers>

  <!-- Points at the public mirror, which is what a consumer can actually reach. Central states
       plainly that this URL "does not need to be public", so the private development repository
       would also have satisfied validation -- the mirror is named here because a dead link on a
       package page is worse than an honest one. -->
  <scm>
    <connection>scm:git:https://github.com/saas-infrastructure/notavia-sdk.git</connection>
    <developerConnection>scm:git:https://github.com/saas-infrastructure/notavia-sdk.git</developerConnection>
    <url>https://github.com/saas-infrastructure/notavia-sdk</url>
    <tag>HEAD</tag>
  </scm>

  <properties>
    <maven.compiler.release>11</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <jackson.version>2.17.2</jackson.version>
    <junit.version>5.10.2</junit.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
      <version>${jackson.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openapitools</groupId>
      <artifactId>jackson-databind-nullable</artifactId>
      <version>0.2.6</version>
    </dependency>
    <dependency>
      <groupId>jakarta.annotation</groupId>
      <artifactId>jakarta.annotation-api</artifactId>
      <version>2.1.1</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
    </plugins>
  </build>
</project>

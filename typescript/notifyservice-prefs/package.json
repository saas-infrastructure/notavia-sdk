{
  "name": "@notavia/prefs",
  "version": "1.0.2",
  "description": "Drop-in <notifyservice-prefs> Lit web component for the Notavia preference centre.",
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "https://github.com/saas-infrastructure/notavia-sdk.git" },
  "bugs": { "url": "https://saas-infrastructure.com/contact?topic=support" },
  "homepage": "https://github.com/saas-infrastructure/notavia-sdk",
  "keywords": ["notavia", "preferences", "web-component", "lit", "saasinfrastructure"],
  "main": "./dist/notifyservice-prefs.umd.js",
  "module": "./dist/notifyservice-prefs.es.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/notifyservice-prefs.es.js",
      "require": "./dist/notifyservice-prefs.umd.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "engines": { "node": ">=20.0.0" },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": ["./dist/notifyservice-prefs.es.js", "./dist/notifyservice-prefs.umd.js"],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "lit": "^3.1.0",
    "@notavia/prefs-client": "^1.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.0.0",
    "@types/node": "^20.11.0",
    "happy-dom": "^14.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.7.0",
    "vitest": "^1.4.0"
  }
}

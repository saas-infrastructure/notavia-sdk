{
  "name": "notavia/notavia",
  "description": "Official PHP SDK for Notavia — send transactional notifications and manage templates.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-json": "*",
    "ext-mbstring": "*",
    "guzzlehttp/guzzle": "^7.5",
    "guzzlehttp/psr7": "^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "NotifyService\\Api\\": "lib/",
      "NotifyService\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "NotifyService\\Tests\\": "tests/"
    }
  }
}
